{
  "name": "laguna-cafe",
  "version": "1.0.0",
  "description": "نظام إدارة مطعم وكافية Laguna Dubai",
  "author": "Laguna Dubai",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "proxy": "node printer-proxy-server.js",
    "build:win": "electron-builder --win portable",
    "build:win-installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.lagunacafe.pos",
    "productName": "Laguna Cafe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "icon": "electron/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
