rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require authentication for all access
    // Admin and QR customers both use anonymous auth, so rules can't
    // distinguish them. QR customers only write invoices from menu.js.
    match /{doc=**} {
      allow read, write: if request.auth != null;
    }
  }
}
