rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isPositiveNumber(val) {
      return val is number && val >= 0;
    }

    // Global: require auth for all access
    match /{doc=**} {
      allow read, write: if isAuth();
    }

    // Invoices: validate fields to prevent abuse
    match /invoices/{docId} {
      allow create: if isAuth()
        && request.resource.data.keys().size() <= 20
        && isValidString(request.resource.data.customer, 200)
        && (!request.resource.data.keys().has('note') || isValidString(request.resource.data.note, 500))
        && (!request.resource.data.keys().has('table') || isValidString(request.resource.data.table, 50))
        && (!request.resource.data.keys().has('id') || isValidString(request.resource.data.id, 50));
      allow update: if isAuth();
      allow delete: if isAuth();
      allow read: if isAuth();
    }

    // Products: validate fields
    match /products/{docId} {
      allow create, update: if isAuth()
        && isValidString(request.resource.data.name, 200)
        && (!request.resource.data.keys().has('nameEn') || isValidString(request.resource.data.nameEn, 200))
        && (!request.resource.data.keys().has('description') || isValidString(request.resource.data.description, 1000));
      allow delete: if isAuth();
      allow read: if isAuth();
    }

    // Customers: validate fields
    match /customers/{docId} {
      allow create, update: if isAuth()
        && isValidString(request.resource.data.name, 200);
      allow delete: if isAuth();
      allow read: if isAuth();
    }

    // Settings: protect from oversized writes
    match /settings/{docId} {
      allow write: if isAuth()
        && request.resource.data.keys().size() <= 30;
      allow read: if isAuth();
    }

    // Expenses: validate
    match /expenses/{docId} {
      allow create: if isAuth()
        && isValidString(request.resource.data.description, 500)
        && isValidString(request.resource.data.category, 100);
      allow update, delete: if isAuth();
      allow read: if isAuth();
    }

    // Inventory: validate
    match /inventory/{docId} {
      allow create, update: if isAuth()
        && isValidString(request.resource.data.name, 200);
      allow delete: if isAuth();
      allow read: if isAuth();
    }

    // Employees: validate
    match /employees/{docId} {
      allow create, update: if isAuth()
        && isValidString(request.resource.data.name, 200)
        && isValidString(request.resource.data.job, 200);
      allow delete: if isAuth();
      allow read: if isAuth();
    }
  }
}
